---
interface Feature {
  title: string
  copy: string
  span: 2 | 3
  icon: string
}

const features: Feature[] = [
  {
    title: 'workspaces',
    copy: 'color-accented profiles with their own cookies, history, proxy, and privacy mode. work and personal never touch.',
    span: 3,
    icon: 'layers',
  },
  {
    title: 'split panes',
    copy: 'tmux-style splits with resizable dividers and click-to-focus. every pane is its own native webview.',
    span: 3,
    icon: 'columns',
  },
  {
    title: 'folders and pins',
    copy: 'group live tabs into colored folders, pin the ones you keep. collapsed folders put their tabs to sleep.',
    span: 2,
    icon: 'folder',
  },
  {
    title: 'tor, built in',
    copy: 'one toggle routes a workspace through tor. no extension, no separate browser.',
    span: 2,
    icon: 'shield',
  },
  {
    title: 'password vault',
    copy: 'encrypted at rest, unlocked with touch id, autofill matched to the origin.',
    span: 2,
    icon: 'lock',
  },
  {
    title: 'peek',
    copy: 'option-click a link to preview it in an isolated, incognito card. suspicious links are flagged before you open them.',
    span: 3,
    icon: 'eye',
  },
  {
    title: 'yours to shape',
    copy: 'layouts, themes, keybindings, search engine, sidebar widgets, per-site user agents. the chrome adapts to you, not the reverse.',
    span: 3,
    icon: 'sliders',
  },
]

const icons: Record<string, string> = {
  layers:
    '<path d="m12 3 8.5 4.6L12 12.2 3.5 7.6 12 3Z"/><path d="m3.5 12.2 8.5 4.6 8.5-4.6"/><path d="m3.5 16.6 8.5 4.6 8.5-4.6"/>',
  columns: '<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M12 4.5v15"/>',
  folder: '<path d="M3.5 7.5a2 2 0 0 1 2-2h4.2l2 2.2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13.2a2 2 0 0 1-2-2v-10.2Z"/>',
  shield: '<path d="M12 3.2 19 6v5.2c0 4.8-3.3 7.8-7 8.8-3.7-1-7-4-7-8.8V6l7-2.8Z"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8.2 11V8a3.8 3.8 0 0 1 7.6 0v3"/>',
  eye: '<path d="M2.5 12S6 6.2 12 6.2 21.5 12 21.5 12 18 17.8 12 17.8 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.8"/>',
  sliders:
    '<path d="M4 8h10M18 8h2M4 16h2M10 16h10"/><circle cx="16" cy="8" r="2"/><circle cx="8" cy="16" r="2"/>',
}
---

<section class="section" id="features">
  <div class="container">
    <p class="eyebrow" data-reveal>02 &middot; features</p>
    <h2 class="section-title" data-reveal>built in, not <em>bolted on</em>.</h2>
    <p class="section-lede" data-reveal>
      everything below ships in the box. unused features cost zero resources:
      heavy subsystems start lazily or not at all.
    </p>
    <div class="grid">
      {
        features.map((f, i) => (
          <article class:list={['card', 'card-g', `span-${f.span}`]} data-reveal style={`transition-delay:${(i % 3) * 70}ms`}>
            <span class="idx mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[f.icon]}
              />
            </div>
            <h3>{f.title}</h3>
            <p>{f.copy}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin-top: 48px;
  }

  .card {
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .span-2 {
    grid-column: span 2;
  }

  .span-3 {
    grid-column: span 3;
  }

  .idx {
    position: absolute;
    top: 24px;
    right: 26px;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: rgba(183, 166, 241, 0.34);
    transition: color var(--speed);
  }

  .card:hover .idx {
    color: rgba(183, 166, 241, 0.7);
  }

  .icon {
    width: 30px;
    height: 30px;
    color: var(--lila-300);
    filter: drop-shadow(0 0 12px rgba(143, 153, 251, 0.5));
    margin-bottom: 10px;
  }

  .icon svg {
    width: 100%;
    height: 100%;
  }

  h3 {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  p {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-2);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .span-2,
    .span-3 {
      grid-column: span 1;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
