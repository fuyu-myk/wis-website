---
import { REPO_URL, RELEASES_URL, RELEASES_LIVE } from '@/lib/site'

const base = import.meta.env.BASE_URL
const buildDocsUrl = `${base}docs/getting-started/building-from-source/`
const installDocsUrl = `${base}docs/getting-started/installation/`

const platforms = [
  { name: 'macos', files: 'wis.dmg · apple silicon & intel · macos 14+', cta: 'download .dmg', primary: true },
  { name: 'linux', files: '.deb · .rpm · .appimage · x86_64', cta: 'download for linux', primary: false },
  { name: 'windows', files: '.msi · .exe · x86_64', cta: 'download for windows', primary: false },
]
---

<section class="section" id="download">
  <div class="container">
    <p class="eyebrow" data-reveal>05 &middot; download</p>
    <h2 class="section-title" data-reveal>get <em>wis</em>.</h2>
    <p class="section-lede" data-reveal>
      releases for macos, linux, and windows are built by github actions and
      published to github releases. builds are not code-signed yet, so the
      first launch takes one extra step; <a href={installDocsUrl}>the install guide</a> walks through it.
    </p>
    <div class="cards">
      {
        platforms.map((p, i) => (
          <article
            class:list={['card', 'card-g', { primary: p.primary }]}
            data-reveal
            style={`transition-delay:${i * 70}ms`}
          >
            <div class="head">
              <h3>{p.name}</h3>
              {RELEASES_LIVE ? (
                <span class:list={['chip', { 'chip-lila': p.primary }]}>latest</span>
              ) : (
                <span class="chip">coming soon</span>
              )}
            </div>
            <p class="file mono">{p.files}</p>
            {RELEASES_LIVE ? (
              <a class:list={['btn', p.primary ? 'btn-fill' : 'btn-ghost']} href={RELEASES_URL} rel="noopener">
                {p.cta}
              </a>
            ) : p.primary ? (
              <p class="pending">
                first release is on its way. until then, <a href={buildDocsUrl}>build from source</a> in a few
                minutes.
              </p>
            ) : (
              <a class="text-link" href={buildDocsUrl}>
                build instructions
              </a>
            )}
          </article>
        ))
      }
    </div>
    <div class="source" data-reveal>
      <p class="src-label mono">or straight from the source</p>
      <pre class="mono"><code>git clone {REPO_URL}.git
cd wis-browser &amp;&amp; make install &amp;&amp; make build</code></pre>
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 48px;
  }

  .card {
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .card.primary {
    border-color: var(--border-lila);
    background: linear-gradient(180deg, rgba(141, 123, 227, 0.13), rgba(141, 123, 227, 0.03));
    box-shadow: 0 0 48px rgba(141, 123, 227, 0.14);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  h3 {
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .file {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-3);
  }

  .pending {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-2);
    margin-top: auto;
  }

  .card .btn {
    margin-top: auto;
    align-self: flex-start;
  }

  .text-link {
    margin-top: auto;
    font-size: 14.5px;
    color: var(--peri);
    text-underline-offset: 3px;
  }

  .source {
    margin-top: 40px;
  }

  .src-label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 12px;
  }

  pre {
    background: rgba(6, 6, 9, 0.8);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 22px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--lila-200);
    overflow-x: auto;
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
